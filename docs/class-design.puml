@startuml JimFortDetailedClassDesign
title Jim Fort - Detailed Class Design

left to right direction
hide empty members

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #334155
  ArrowColor #475569
}

legend left
  <<table>> Supabase/Postgres table inferred from current app queries.
  <<value>> TypeScript value/interface used by pages and helpers.
  <<service>> Next.js data helper module.
  <<serverAction>> Next.js server action module.
  <<page>> App Router screen group.
endlegend

note as ModelNote
  This class design is inferred from the current Next.js codebase.
  The repository notes that supabase/migrations was reset, so table fields
  are reconstructed from queries, actions, and exported TypeScript types.
end note

package "Common Enums" {
  enum Role {
    owner
    manager
    pt
    member
  }

  enum AccountStatus {
    active
    inactive
    disabled
  }

  enum StaffStatus {
    active
    inactive
    on_leave
    terminated
  }

  enum RoomStatus {
    active
    maintenance
    closed
  }

  enum EquipmentStatus {
    active
    maintenance
    broken
    retired
  }

  enum MembershipPackageStatus {
    active
    inactive
    archived
  }

  enum SubscriptionStatus {
    pending_pt_setup
    pending_payment
    active
    expired
    cancelled
  }

  enum PaymentStatus {
    pending
    paid
    cancelled
  }

  enum VoucherDiscountType {
    percentage
    amount
  }

  enum VoucherStatus {
    active
    disabled
    expired
    scheduled
    redeemed
  }

  enum PtGenderPreference {
    no_preference
    male
    female
  }

  enum ExperienceLevel {
    no_preference
    beginner
    intermediate
    advanced
  }

  enum PtAssignmentStatus {
    pending_member_decision
    accepted
    rejected
  }

  enum SessionStatus {
    scheduled
    completed
    missed
    cancelled
    rescheduled
  }

  enum FeedbackStatus {
    open
    responded
    closed
    sent
    read
  }
}

package "Auth and Routing" {
  class "accounts" as Account <<table>> {
    +id: uuid
    +email: string
    +passwordHash: string
    +status: AccountStatus
    +createdAt: DateTime
    +updatedAt: DateTime?
  }

  class "users" as AppUser <<table>> {
    +id: uuid
    +accountId: uuid?
    +fullName: string
    +phone: string?
    +avatarUrl: string?
    +role: Role
    +createdAt: DateTime?
    +updatedAt: DateTime?
  }

  class SupabaseAuthUser <<external>> {
    +id: uuid
    +email: string
    +appMetadata.app_role: Role
    +userMetadata.full_name: string?
    +userMetadata.phone: string?
  }

  class AuthenticatedUser <<value>> {
    +id: string
    +email: string
    +fullName: string
    +issuedAt: number?
    +role: Role
    +username: string
  }

  class RouteAccessRule <<value>> {
    +label: string
    +path: string
    +roles: Role[]
  }

  class AuthContextService <<service>> {
    +createAuthContext(claims): AuthenticatedUser?
    +serializeAuthContext(user): string
    +parseAuthContext(value): AuthenticatedUser?
  }

  class CurrentUserService <<service>> {
    +getOptionalAuthenticatedUser(): AuthenticatedUser?
    +getAuthenticatedUser(): AuthenticatedUser
    +getAuthenticatedRole(): Role
  }

  class RouteAccessService <<service>> {
    +isRole(role): boolean
    +getRouteAccess(pathname): RouteAccessRule?
    +canAccessRoute(pathname, role): boolean
    +getDefaultRouteForRole(role): string
  }

  class SupabaseServerClient <<service>> {
    +createClient(): ServerClient
  }

  class SupabaseBrowserClient <<service>> {
    +createClient(): BrowserClient
  }

  class SupabaseAdminClient <<service>> {
    +createAdminClient(): AdminClient
  }

  class SessionMiddleware <<service>> {
    +updateSession(request): NextResponse
    -redirectWithSessionCookies(url, response): NextResponse
    -getSafeReturnPath(request, role): string
  }

  class LoginActionService <<serverAction>> {
    +login(state, formData): LoginActionState
    +signOut(): redirect
  }
}

